{
  // ADT Backlog Wizard. Deployed by .github/workflows/deploy.yml when a change
  // reaches the backlog-wizard branch, or by hand (see AGENTS.md):
  //   pnpm run deploy
  "name": "adt-backlog-wizard",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Hourly: redeliver failed webhook deliveries, and put Block field and
  // `block:` label back in step.
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    // The unicef GitHub App "ADT Backlog Wizard" (docs/ADMIN-SETUP.md). None
    // of these is secret. APP_ID is filled in once the org admin creates it;
    // BOT_LOGIN is <the App's slug>[bot]: check it then (`pnpm app info`).
    "APP_ID": "",
    "BOT_LOGIN": "adt-backlog-wizard[bot]",
    // Node id of the Kanban Project (unicef #46). The bot ignores every other Project.
    "PROJECTS": "PVT_kwDOAAKu6c4BlQRn"
  }
  // Secrets, set once with `pnpm wrangler secret put <NAME>` (see AGENTS.md):
  //   WEBHOOK_SECRET   the App's webhook secret
  //   APP_PRIVATE_KEY  the App's private key, converted to PKCS#8
}
