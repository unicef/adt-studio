{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "../../scripts/release-version.d.mts",
    "../../scripts/release-source-notes.d.mts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@root/scripts/release-version.mjs": [
        "../../scripts/release-version.d.mts"
      ],
      "@root/scripts/release-source-notes.mjs": [
        "../../scripts/release-source-notes.d.mts"
      ],
      "@root/*": ["../../*"]
    }
  }
}
