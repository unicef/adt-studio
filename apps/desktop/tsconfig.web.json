{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "@adt/types",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@root/scripts/release-version.mjs": [
        "../../scripts/release-version.d.mts"
      ],
      "@root/scripts/release-source-notes.mjs": [
        "../../scripts/release-source-notes.d.mts"
      ],
      "@renderer/*": [
        "src/renderer/src/*"
      ]
    }
  }
}
